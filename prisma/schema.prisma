generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum PeriodicityUnit {
  DAY
  WEEK
  MONTH
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String
  createdAt     DateTime            @default(now())
  settings      Settings?
  categories    Category[]
  expenses      Expense[]
  wishlistItems WishlistItem[]
  incomeEntries IncomeEntry[]
  expenseChecks ExpenseCycleCheck[]
}

model Settings {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleStartDay Int
  updatedAt     DateTime @updatedAt
}

/// Revenu mensuel récurrent : tombe une fois par cycle, le jour dayOfMonth.
model IncomeEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  amount     Float
  dayOfMonth Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Category {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  color         String
  expenses      Expense[]
  wishlistItems WishlistItem[]

  @@unique([userId, name])
}

model Expense {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  amount           Float
  categoryId       String
  category         Category            @relation(fields: [categoryId], references: [id])
  isOneTime        Boolean             @default(false)
  periodicityUnit  PeriodicityUnit?
  periodicityValue Int?
  dueDate          DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  cycleChecks      ExpenseCycleCheck[]
}

/// "Cette dépense est prise en compte pour ce cycle."
/// cycleKey = date de début du cycle en heure locale, format "YYYY-MM-DD" (jamais un DateTime,
/// pour ne pas dépendre du fuseau horaire de stockage de l'adaptateur SQLite).
model ExpenseCycleCheck {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleKey  String
  checkedAt DateTime @default(now())

  @@unique([expenseId, cycleKey])
  @@index([userId, cycleKey])
}

model WishlistItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  budget      Float
  isPurchased Boolean   @default(false)
  purchasedAt DateTime?
  createdAt   DateTime  @default(now())
}
